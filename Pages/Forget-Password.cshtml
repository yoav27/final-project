@* הגדרת הנתיב כעמוד Razor Pages עבור איפוס סיסמה *@
@page
@model Forget_PasswordModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = null; /* מנתק את העמוד מה-Layout הדיפולטיבי כדי לאפשר עיצוב עצמאי */
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"> <!-- הגדרת קידוד תווים לתמיכה בשפות שונות -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" /> <!-- התאמת התצוגה למסכי מובייל -->
    <title>Reset Password</title> <!-- כותרת הכרטיסייה בדפדפן -->
    <!-- טעינת ספריית האייקונים Font Awesome עבור העין בסיסמה ואייקוני המותג -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* איפוס הגדרות ברירת מחדל לכל האלמנטים */
        * {
            box-sizing: border-box; /* הכללת פדינג בחישוב הרוחב */
            margin: 0; /* ביטול מרווחים חיצוניים */
            padding: 0; /* ביטול מרווחים פנימיים */
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; /* פונט מודרני */
        }

        /* עיצוב גוף העמוד */
        body {
            background-color: #ffffff; /* רקע לבן */
            min-height: 100vh; /* גובה מסך מלא */
            overflow-x: hidden; /* מניעת פס גלילה אופקי */
        }

        /* מעטפת ראשית שמחלקת את המסך לשניים */
        .split-container {
            display: flex; /* תצוגה גמישה בשתי עמודות */
            width: 100vw; /* רוחב מסך מלא */
            min-height: 100vh; /* גובה מסך מלא */
        }

        /* צד שמאל: המותג הצהוב (50%) */
        .left-side {
            width: 50%; /* חצי מסך */
            flex: 0 0 50%; /* מניעת שינוי רוחב */
            background: linear-gradient(135deg, #e3b02b 0%, #c48a00 100%); /* מפל צבעים צהוב-תיקייה */
            color: #ffffff; /* טקסט לבן */
            display: flex; /* יישור מרכזי */
            flex-direction: column; /* סידור אנכי */
            justify-content: center; /* יישור אנכי למרכז */
            align-items: center; /* יישור אופקי למרכז */
            padding: 60px; /* מרווח פנימי */
            text-align: center; /* יישור טקסט למרכז */
        }

        /* מעטפת התוכן בצד שמאל */
        .left-content {
            max-width: 480px; /* הגבלת רוחב כדי שלא להתפשט מדי */
        }

        /* אייקון התיקייה הראשי */
        .hero-icon {
            font-size: 100px; /* גודל האייקון */
            margin-bottom: 30px; /* מרווח תחתון */
            color: #ffffff; /* צבע לבן */
            filter: drop-shadow(0 10px 15px rgba(0,0,0,0.15)); /* צל רך מתחת לאייקון */
        }

        /* כותרת ראשית בצד שמאל */
        .hero-title {
            font-size: 38px; /* גודל גופן */
            font-weight: 700; /* מודגש */
            line-height: 1.2; /* מרווח שורות */
            margin-bottom: 20px; /* מרווח תחתון */
        }

        /* תיאור המותג בצד שמאל */
        .hero-description {
            font-size: 18px; /* גודל גופן */
            line-height: 1.6; /* מרווח שורות */
            opacity: 0.95; /* שקיפות קלה להרככה */
            margin-bottom: 40px; /* מרווח תחתון */
        }

        /* רשימת האייקונים בתחתית צד שמאל */
        .features-list {
            display: flex; /* סידור אופקי */
            gap: 20px; /* רווח בין פריטים */
            justify-content: center; /* יישור למרכז */
            border-top: 1px solid rgba(255, 255, 255, 0.3); /* קו הפרדה עליון עדין */
            padding-top: 30px; /* מרווח עליון */
        }

        /* פריט ברשימת האייקונים */
        .feature-item {
            font-size: 14px; /* גודל גופן */
            display: flex; /* סידור אופקי */
            align-items: center; /* יישור למרכז */
            gap: 8px; /* רווח בין האייקון לטקסט */
        }

        /* צד ימין: טופס איפוס הסיסמה (50%) */
        .right-side {
            width: 50%; /* חצי מסך */
            flex: 0 0 50%; /* מניעת שינוי רוחב */
            display: flex; /* יישור מרכזי */
            flex-direction: column; /* סידור אנכי */
            justify-content: center; /* יישור אנכי למרכז */
            align-items: center; /* יישור אופקי למרכז */
            padding: 40px; /* מרווח פנימי */
            background-color: #ffffff; /* רקע לבן */
        }

        /* קופסת הטופס המרכזית */
        .login-box {
            width: 100%; /* רוחב מלא במעטפת */
            max-width: 380px; /* הגבלת רוחב מקסימלי לטופס */
        }

        /* כותרת Reset צהובה */
        .welcome-title {
            font-size: 40px; /* גודל גופן */
            font-weight: 700; /* מודגש */
            color: #e3b02b; /* צהוב ממותג */
            margin-bottom: 8px; /* מרווח תחתון */
        }

        /* כותרת משנה Reset Password */
        .login-subtitle {
            font-size: 22px; /* גודל גופן */
            margin-bottom: 25px; /* מרווח תחתון לשדות */
            color: #3d3b36; /* אפור כהה */
        }

        /* קבוצת שדה בטופס */
        .form-group {
            margin-bottom: 16px; /* מרווח בין השדות */
            text-align: left; /* יישור טקסט לשמאל */
        }

            /* תגיות ה-Label מעל השדות */
            .form-group label {
                display: block; /* הצגה כבלוק */
                font-size: 14px; /* גודל גופן */
                font-weight: 600; /* חצי מודגש */
                margin-bottom: 6px; /* מרווח תחתון לשדה */
                color: #4a4744; /* צבע אפור אצילי */
            }

        /* מעטפת השדה והעין */
        .input-wrapper {
            position: relative; /* מיקום יחסי עבור מיקום כפתור העין בצד ימין */
            display: flex; /* יישור אופקי */
            align-items: center; /* יישור אנכי */
        }

        /* תיבות הקלט (Input) */
        .form-control {
            width: 100%; /* רוחב מלא */
            padding: 11px 14px; /* מרווח פנימי להקלדה */
            padding-right: 40px; /* מקום שמור לעין בצד ימין כדי שהטקסט לא יעלה עליה */
            font-size: 14px; /* גודל הטקסט المוקלד */
            border: 1px solid #e0dcd5; /* גבול עדין */
            border-radius: 8px; /* פינות מעוגלות */
            outline: none; /* ביטול מסגרת ברירת המחדל */
            background-color: #ffffff; /* רקע לבן */
            transition: border-color 0.2s, box-shadow 0.2s; /* מעבר חלק בפוקוס */
        }

            /* העצמת שדה בזמן הקלדה (Focus) */
            .form-control:focus {
                border-color: #e3b02b; /* גבול צהוב */
                box-shadow: 0 0 0 3px rgba(227, 176, 43, 0.2); /* הילה צהובה עדינה */
            }

        /* כפתור העין להצגת הסיסמה */
        .toggle-password {
            position: absolute; /* מיקום מוחלט בתוך התיבה */
            right: 12px; /* מיקום מימין */
            background: none; /* ללא רקע */
            border: none; /* ללא מסגרת */
            cursor: pointer; /* סמן יד */
            color: #d99b00; /* צבע צהוב לאייקון */
            font-size: 16px; /* גודל האייקון */
            display: flex; /* יישור מרכזי */
            align-items: center;
            justify-content: center;
        }

        /* כפתור Submit ראשי לאיפוס סיסמה */
        .btn-submit {
            width: 100%; /* רוחב מלא */
            background-color: #e3b02b; /* צהוב ממותג */
            color: #ffffff; /* טקסט לבן */
            border: none; /* ללא מסגרת */
            border-radius: 8px; /* פינות מעוגלות */
            padding: 13px; /* פדינג נוח */
            font-size: 16px; /* גודל טקסט */
            font-weight: 600; /* מודגש */
            cursor: pointer; /* סמן יד */
            margin-top: 10px; /* מרווח עליון מהשדות */
            transition: background-color 0.2s, transform 0.1s; /* אפקט בלחיצה */
        }

            /* אפקט מעבר עכבר (Hover) לכפתור */
            .btn-submit:hover {
                background-color: #c48a00; /* צהוב כהה יותר */
            }

            /* אפקט לחיצה (Active) לכפתור */
            .btn-submit:active {
                transform: scale(0.99); /* כיווץ מיקרוסקופי בלחיצה */
            }

        /* טקסט וקישור חזרה להתחברות */
        .signup-text {
            margin-top: 20px; /* מרווח עליון מהכפתור */
            text-align: center; /* יישור למרכז */
            font-size: 14px; /* גודל גופן */
            color: #666059; /* צבע אפור */
        }

            /* קישור ה-Log in */
            .signup-text a {
                color: #d99b00; /* צבע צהוב */
                text-decoration: none; /* ביטול קו תחתון */
                font-weight: 600; /* חצי מודגש */
            }

                /* קו תחתון במעבר עכבר על הקישור */
                .signup-text a:hover {
                    text-decoration: underline;
                }

        /* הודעת שגיאה באדום במידה והאיפוס נכשל */
        .error-message {
            color: #d93025; /* צבע אדום */
            margin-bottom: 15px; /* מרווח תחתון */
            font-size: 14px; /* גודל גופן */
            font-weight: bold; /* מודגש */
            text-align: center; /* יישור למרכז */
        }

        /* העלמת עין ברירת המחדל של דפדפנים מסוימים */
        input[type="password"]::-ms-reveal,
        input[type="password"]::-ms-clear {
            display: none;
        }

        /* התאמה למסכי מובייל (Responsive) */
        @@media (max-width: 850px) {
            .split-container {
                display: block !important;
            }

            .left-side, .right-side {
                width: 100% !important;
                flex: 0 0 100% !important;
                padding: 40px 20px !important;
            }
        }
    </style>
</head>
<body>

    <!-- מעטפת ראשית החוצה את המסך -->
    <div class="split-container">

        <!-- צד שמאל: מותג ויזואלי (50%) -->
        <div class="left-side">
            <div class="left-content">
                <i class="fa-solid fa-folder-open hero-icon"></i> <!-- אייקון תיקייה -->
                <h1 class="hero-title">Fast & Secure File Sharing</h1> <!-- כותרת מותג -->
                <p class="hero-description">Manage, store, and share your files effortlessly anywhere, anytime.</p> <!-- תיאור -->
                <div class="features-list">
                    <!-- אייקונים נלווים -->
                    <div class="feature-item"><i class="fa-solid fa-shield-halved"></i> Secure</div>
                    <div class="feature-item"><i class="fa-solid fa-bolt"></i> Fast Upload</div>
                    <div class="feature-item"><i class="fa-solid fa-cloud"></i> Cloud Storage</div>
                </div>
            </div>
        </div>

        <!-- צד ימין: טופס איפוס הסיסמה (50%) -->
        <div class="right-side">
            <div class="login-box">
                <h1 class="welcome-title">Reset Password</h1> <!-- כותרת צהובה -->
                <!-- הצגת הודעת שגיאה מ-C# אם הסיסמאות אינן תואמות -->
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="error-message">@Model.ErrorMessage</div>
                }

                <!-- טופס איפוס הסיסמה שנשלח אל קובץ ה-CS -->
                <form method="post">
                    
                    <!-- שדה אימייל לזהות את המשתמש -->
                    <div class="form-group">
                        <label for="email">Email</label> <!-- תגית אימייל -->
                        <input type="email" asp-for="Email" id="email" class="form-control" placeholder="Enter your email" required /> <!-- תיבת קלט לאימייל -->
                    </div>

                    <!-- שדה 1: New Password -->
                    <div class="form-group">
                        <label for="newPassword">New Password</label> <!-- תגית השדה -->
                        <div class="input-wrapper">
                            <input type="password" asp-for="NewPassword" id="newPassword" class="form-control" placeholder="Enter new password" required /> <!-- תיבת הקלדת סיסמה חדשה -->
                            <button type="button" class="toggle-password" onclick="togglePass('newPassword', 'icon1')">
                                <!-- כפתור עין לסיסמה 1 -->
                                <i class="fa-regular fa-eye" id="icon1"></i> <!-- אייקון עין -->
                            </button>
                        </div>
                    </div>

                    <!-- שדה 2: Confirm Password -->
                    <div class="form-group">
                        <label for="confirmPassword">Confirm Password</label> <!-- תגית אישור סיסמה -->
                        <div class="input-wrapper">
                            <input type="password" asp-for="ConfirmPassword" id="confirmPassword" class="form-control" placeholder="Confirm new password" required /> <!-- תיבת הקלדת אישור סיסמה -->
                            <button type="button" class="toggle-password" onclick="togglePass('confirmPassword', 'icon2')">
                                <!-- כפתור עין לסיסמה 2 -->
                                <i class="fa-regular fa-eye" id="icon2"></i> <!-- אייקון עין -->
                            </button>
                        </div>
                    </div>

                    <!-- כפתור שליחה ראשי לאיפוס הסיסמה -->
                    <button type="submit" class="btn-submit">Reset Password</button>

                    <!-- קישור מעבר חזרה לעמוד ההתחברות -->
                    <p class="signup-text">
                        Remembered your password? <a asp-page="/Index">Log in</a> <!-- מקשר חזרה לעמוד ההתחברות -->
                    </p>

                </form>

            </div> <!-- סגירת login-box -->
        </div> <!-- סגירת right-side -->

    </div> <!-- סגירת split-container -->
    <!-- סקריפט JavaScript להפעלת כפתורי העין עבור שתי הסיסמאות -->
    <script>
        // פונקציה כללית המקבלת את מזהה השדה ומזהה האייקון ומחליפה מצב הצגה
        function togglePass(inputId, iconId) {
            const input = document.getElementById(inputId); // שליפת שדה הסיסמה
            const icon = document.getElementById(iconId); // שליפת אלמנט האייקון

            // בדיקה אם השדה במצב מוצפן או טקסט גלוי
            if (input.type === 'password') {
                input.type = 'text'; // הפיכת הקלט לטקסט גלוי
                icon.classList.remove('fa-eye'); // הסרת אייקון עין פתוחה
                icon.classList.add('fa-eye-slash'); // הוספת אייקון עין סגורה
            } else {
                input.type = 'password'; // החזרת הקלט למצב מוצפן
                icon.classList.remove('fa-eye-slash'); // הסרת אייקון עין סגורה
                icon.classList.add('fa-eye'); // הוספת אייקון עין פתוחה
            }
        }
    </script>

</body>
</html>